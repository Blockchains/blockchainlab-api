     "lag_blocks": {
      "type": [
       "null",
       "number"
      ]
     },
     "healthy": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "checked_at": {
      "type": [
       "null",
       "string"
      ]
     },
     "error": {
      "type": [
       "null",
       "string"
      ]
     }
    },
    "required": [
     "chain",
     "checked_at",
     "healthy",
     "ok",
     "url"
    ]
   }
