    "null",
    "string"
   ]
  },
  "api_version": {
   "type": [
    "null",
    "string"
   ]
  },
  "schema_version": {
   "type": [
    "null",
    "string"
   ]
  },
  "schema_url": {
   "type": [
    "string",
    "integer",
    "null"
   ]
  },
  "description": {
   "type": [
    "null",
    "string"
   ]
  },
  "generated_at": {
   "type": [
    "string",
    "integer",
    "null"
   ]
  },
  "source": {
   "type": [
    "null",
    "string"
   ]
  },
  "source_url": {
   "type": [
    "null",
    "string"
   ]
  },
  "built_by": {
   "type": [
    "null",
    "string"
   ]
  },
  "licence_note": {
   "type": [
    "null",
    "string"
   ]
  },
  "count": {
   "type": [
    "string",
    "integer",
    "null"
   ]
  },
  "healthy": {
